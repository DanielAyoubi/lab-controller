{
  "log_dir": "O:\\Nat_Chem-Aerosol-data\\People\\Daniel Ayoubi\\data",
  "log_prefix": "nsim_log",
  "max_plot_points": 500,

  // The lab setup. Add/remove devices in Settings → Devices, or edit here.
  //   type    one of: vogtlin_mfc, dewmaster_hygrometer, vaisala_rh,
  //           julabo_chiller, firesting_o2   (see src/devices/registry.py)
  //   tag     display name — plot legend, control panel labels
  //   id      CSV column prefix; fixed at creation, never renamed
  //   role    what the control loops use this device for. One holder each:
  //           wet_flow, dry_flow, rh_source, temp_source, o2_source, none
  "devices": [
    {
      "id": "wet_mfc",
      "type": "vogtlin_mfc",
