      "role": "wet_flow",
      "enabled": true,
      "port": "COM23",
      "baudrate": 9600,
      "address": 24
    },
    {
      "id": "vaisala_hmp110_rh_probe_2",
      "type": "vaisala_rh",
      "tag": "RH upstream",
      "role": "rh_source",
      "enabled": true,
      "port": "COM24",
      "baudrate": 19200,
      "address": 240
    },
    {
      "id": "vaisala_hmp110_rh_probe_2_2",
      "type": "vaisala_rh",
      "tag": "RH downstream",
      "role": "none",
      "enabled": true,
      "port": "COM21",
      "baudrate": 19200,
      "address": 240
    },
    {
      "id": "vogtlin_mfc_3",
      "type": "vogtlin_mfc",
      "tag": "Dry MFC",
      "role": "dry_flow",
      "enabled": true,
